#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&trans            &trans  &trans    &trans  &trans  &trans       &mmv MOVE_UP     &trans     &trans  &trans     &trans   &trans    &trans
&kp TAB           &kp Q   &kp W     &kp E   &kp R   &kp T        &mmv MOVE_DOWN   &kp Y      &kp U   &kp I      &kp O    &kp P     &kp BSPC
&mt LCTRL ESCAPE  &kp A   &kp S     &kp D   &kp F   &kp G        &mmv MOVE_LEFT   &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp RET
&kp LSHFT         &kp Z   &kp X     &kp C   &kp V   &kp B        &mmv MOVE_RIGHT  &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
&kp C_MUTE        &trans  &mkp MB1  &mo 7   &mo 5   &kp SPACE    &mkp LCLK        &kp SPACE  &mo 6   &trans     &trans   &trans
            >;

            display-name = "base";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>, <&rsr_trans>;
        };

        game1 {
            bindings = <
&trans      &trans  &trans  &trans        &trans     &trans    &mmv MOVE_UP     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp GRAVE
&kp TAB     &kp Q   &kp W   &kp E         &kp R      &kp T     &mmv MOVE_DOWN   &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp ESC
&kp LCTRL   &kp A   &kp S   &kp D         &kp F      &kp G     &mmv MOVE_LEFT   &kp E         &kp R         &kp G         &kp C         &kp Q         &kp RET
&kp LSHFT   &kp Z   &kp X   &kp C         &kp V      &kp B     &mmv MOVE_RIGHT  &kp V         &kp B         &kp Z         &kp X         &kp T         &kp F5
&kp C_MUTE  &trans  &trans  &kp LEFT_ALT  &kp SPACE  &mo 2     &mkp LCLK        &kp SPACE     &mo 4         &mkp MB1      &kp F         &kp H
            >;

            display-name = "game1";
            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&rsr_trans>;
        };

        game2 {
            bindings = <
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp GRAVE   &trans        &trans        &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &trans        &trans        &trans        &kp NUMBER_3  &kp NUMBER_4    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_5  &kp NUMBER_6    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "game2";
        };

        game3 {
            bindings = <
&trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp F5      &kp Y   &kp U   &kp I   &kp O   &kp P       &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp H   &kp J   &kp K   &kp L   &kp RET     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp N   &kp M   &trans  &trans  &kp BSPC    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "game3";
        };

        game4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N5    &kp N6  &kp N7     &kp N8  &kp N9  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N1    &kp N2  &kp N3     &kp N4  &kp N5  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &kp UP  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LEFT  &kp UP  &kp RIGHT  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans     &trans  &trans
            >;

            label = "game4";
        };

        num {
            bindings = <
&kp LGUI  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &kp N7  &kp N8  &kp N9  &trans    &trans  &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans    &trans  &kp N4  &kp N5  &kp N6  &trans    &trans  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans    &trans  &kp N1  &kp N2  &kp N3  &trans    &trans  &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
&trans    &trans  &trans  &kp N0  &trans  &trans    &trans  &trans  &trans  &kp N0  &trans  &trans
            >;

            label = "num";
        };

        sym {
            bindings = <
&trans  &trans           &trans        &trans         &trans            &trans            &trans  &trans             &trans                &trans                 &trans        &trans     &trans
&trans  &kp GRAVE        &kp TILDE     &kp LESS_THAN  &kp GREATER_THAN  &kp CARET         &trans  &kp SQT            &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp ASTERISK  &kp PLUS   &trans
&trans  &kp AT_SIGN      &kp HASH      &kp DOLLAR     &kp PERCENT       &kp AMPERSAND     &trans  &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SLASH     &kp MINUS  &trans
&trans  &kp EXCLAMATION  &kp QUESTION  &kp PIPE       &kp COLON         &kp UNDERSCORE    &trans  &kp COMMA          &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOT       &kp EQUAL  &trans
&trans  &trans           &trans        &trans         &trans            &trans            &trans  &trans             &trans                &trans                 &trans        &trans
            >;

            label = "sym";
        };

        nav {
            bindings = <
&trans      &trans    &trans    &trans     &trans     &trans       &trans  &trans    &trans     &trans     &trans     &trans  &trans
&trans      &kp HOME  &kp UP    &kp END    &kp PG_DN  &kp PG_UP    &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans  &kp DEL
&kp ESCAPE  &kp LEFT  &kp DOWN  &kp RIGHT  &mkp MB1   &mkp MB2     &trans  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&trans      &trans    &trans    &trans     &trans     &trans       &trans  &mkp MB3  &mkp MB4   &mkp MB5   &trans     &trans  &trans
&trans      &trans    &trans    &trans     &trans     &trans       &trans  &trans    &trans     &trans     &trans     &trans
            >;

            label = "nav";
        };

        fn {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans  &trans          &trans          &trans          &trans              &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans    &trans  &trans  &kp LC(LA(F1))  &kp LA(LC(F2))  &kp LA(LC(F3))  &kp LA(LC(F4))      &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans    &trans  &trans  &kp LA(LC(F5))  &kp LA(LC(F6))  &kp LA(LC(F6))  &kp LC(LA(DELETE))  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &trans  &trans          &trans          &trans          &trans              &trans
&trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans  &trans          &trans          &trans          &trans
            >;

            label = "fn";
        };
    };
};
