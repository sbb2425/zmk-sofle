#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&sl {
    release-after-ms = <3000>;
    ignore-modifiers;
};

&sk { release-after-ms = <5000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    ht_2kp: ht_2kp {
        compatible = "zmk,behavior-hold-tap";
        label = "HT_2KP";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        flavor = "tap-preferred";
    };

    short_sl: short_sl {
        compatible = "zmk,behavior-sticky-key";
        label = "SHORT_SL";
        bindings = <&sl>;
        #binding-cells = <1>;
        release-after-ms = <1000>;
        quick-release;
    };

    exit_num: exit_num {
        compatible = "zmk,behavior-tap-dance";
        label = "EXIT_NUM";
        #binding-cells = <0>;
        bindings = <&tog 5>, <&to 0>;
    };

    exit_sym: exit_sym {
        compatible = "zmk,behavior-tap-dance";
        label = "EXIT_SYM";
        #binding-cells = <0>;
        bindings = <&tog 6>, <&to 0>;
    };

    exit_nav: exit_nav {
        compatible = "zmk,behavior-tap-dance";
        label = "EXIT_NAV";
        #binding-cells = <0>;
        bindings = <&tog 7>, <&to 0>;
    };

    exit_fn: exit_fn {
        compatible = "zmk,behavior-tap-dance";
        label = "EXIT_FN";
        #binding-cells = <0>;
        bindings = <&tog 8>, <&to 0>;
    };

    exit_media: exit_media {
        compatible = "zmk,behavior-tap-dance";
        label = "EXIT_MEDIA";
        #binding-cells = <0>;
        bindings = <&tog 9>, <&to 0>;
    };

    exit_swap: exit_swap {
        compatible = "zmk,behavior-tap-dance";
        label = "EXIT_SWAP";
        #binding-cells = <0>;
        bindings = <&tog 0>, <&to 0>;
    };

    exit_func: exit_func {
        compatible = "zmk,behavior-tap-dance";
        label = "EXIT_FUNC";
        #binding-cells = <0>;
        bindings = <&tog 10>, <&to 0>;
    };

    exit_mod: exit_mod {
        compatible = "zmk,behavior-tap-dance";
        label = "EXIT_MOD";
        #binding-cells = <0>;
        bindings = <&tog 0>, <&to 0>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };

        escape_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <34 35>;
            layers = <0 5 6 7 8>;
            slow-release;
        };

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <29 30>;
            layers = <0 5 6 7 8>;
            slow-release;
        };

        sl_game3_layer {
            bindings = <&sl 3>;
            key-positions = <57 39>;
            layers = <1>;
            timeout-ms = <50>;
            require-prior-idle-ms = <50>;
        };

        mo_nav_layer {
            bindings = <&mo 7>;
            key-positions = <55 26>;
            layers = <1>;
            require-prior-idle-ms = <20>;
            timeout-ms = <70>;
        };

        mo_media_layer {
            bindings = <&mo 9>;
            key-positions = <55 39>;
            timeout-ms = <50>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        midle_key {
            bindings = <&mkp MCLK>;
            key-positions = <54 53>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none                    &none           &none               &none                   &none                 &none        &mmv MOVE_UP     &none      &none                  &none                        &none                  &none               &none
&kp TAB                  &kp Q           &kp W               &kp E                   &kp R                 &kp T        &mmv MOVE_DOWN   &kp Y      &kp U                  &kp I                        &kp O                  &kp P               &kp BSPC
&ht_2kp LCTRL ESCAPE     &kp A           &kp S               &kp D                   &kp F                 &kp G        &mmv MOVE_LEFT   &kp H      &kp J                  &kp K                        &kp L                  &kp SEMI            &kp RET
&mt LSHFT LA(LC(SPACE))  &ht_2kp LGUI Z  &ht_2kp LEFT_ALT X  &ht_2kp LEFT_CONTROL C  &ht_2kp LEFT_SHIFT V  &kp B        &mmv MOVE_RIGHT  &kp N      &ht_2kp RIGHT_SHIFT M  &ht_2kp RIGHT_CONTROL COMMA  &ht_2kp RIGHT_ALT DOT  &ht_2kp RGUI SLASH  &kp BSLH
&none                    &mo 9           &mo 11              &mo 7                   &mo 5                 &kp SPACE    &mkp LCLK        &kp SPACE  &mo 6                  &mo 8                        &none                  &none
            >;

            label = "BASE";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        game {
            bindings = <
&none       &none  &none  &none     &none      &none    &mmv MOVE_UP     &kp N1     &kp N2  &kp N3          &kp N4  &kp N5  &kp ESC
&kp TAB     &kp Q  &kp W  &kp E     &kp R      &kp T    &mmv MOVE_DOWN   &kp N6     &kp N7  &kp N8          &kp N9  &kp N0  &none
&kp LCTRL   &kp A  &kp S  &kp D     &kp F      &kp G    &mmv MOVE_LEFT   &kp E      &kp R   &kp G           &kp C   &kp Q   &kp ENTER
&kp LSHFT   &kp Z  &kp X  &kp C     &kp V      &kp B    &mmv MOVE_RIGHT  &kp V      &kp B   &kp Z           &kp X   &kp T   &kp F5
&kp C_MUTE  &mo 3  &mo 7  &kp LALT  &kp SPACE  &mo 2    &mkp LCLK        &kp SPACE  &mo 4   &kp DOWN_ARROW  &kp F   &kp H
            >;

            label = "GAME";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        game2 {
            bindings = <
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp GRAVE   &trans        &trans        &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &trans        &trans        &trans        &kp NUMBER_3  &kp NUMBER_4    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&mo 3       &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_5  &kp NUMBER_6    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "G2";
        };

        game3 {
            bindings = <
&trans   &trans  &trans  &trans  &trans  &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp F5   &kp Y   &kp U   &kp I   &kp O   &kp P            &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp ESC  &kp H   &kp J   &kp K   &kp L   &kp ENTER        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp N   &kp M   &trans  &trans  &kp BACKSPACE    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans           &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "G3";
        };

        game4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp NUMBER_6    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp UP_ARROW    &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp DOWN_ARROW  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans        &trans        &trans        &trans
            >;
        };

        num {
            bindings = <
&none   &none   &none         &none         &none         &none        &none  &none   &none         &none         &none         &none   &none
&trans  &trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans       &none  &trans  &kp N7        &kp N8        &kp N9        &trans  &trans
&trans  &trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans       &none  &trans  &kp N4        &kp N5        &kp N6        &trans  &trans
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans       &none  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
&none   &none   &none         &kp NUMBER_0  &exit_num     &kp SPACE    &none  &trans  &trans        &kp N0        &none         &none
            >;

            label = "NUM";
        };

        sym {
            bindings = <
&none   &none                         &none                      &none                      &none                     &none             &trans  &none              &none                           &none                              &none                  &none      &none
&trans  &kp GRAVE                     &kp TILDE                  &kp LESS_THAN              &kp GREATER_THAN          &kp CARET         &trans  &kp APOSTROPHE     &kp LEFT_BRACKET                &kp RIGHT_BRACKET                  &kp ASTERISK           &kp PLUS   &trans
&trans  &kp AT_SIGN                   &kp HASH                   &kp DOLLAR                 &kp PERCENT               &kp AMPERSAND     &trans  &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS            &kp RIGHT_PARENTHESIS              &kp SLASH              &kp MINUS  &trans
&trans  &ht_2kp LEFT_GUI EXCLAMATION  &ht_2kp LEFT_ALT QUESTION  &ht_2kp LEFT_CONTROL PIPE  &ht_2kp LEFT_SHIFT COLON  &kp UNDERSCORE    &trans  &kp COMMA          &ht_2kp RIGHT_SHIFT LEFT_BRACE  &ht_2kp RIGHT_CONTROL RIGHT_BRACE  &ht_2kp RIGHT_ALT DOT  &kp EQUAL  &trans
&trans  &none                         &none                      &trans                     &exit_sym                 &trans            &trans  &trans             &exit_sym                       &trans                             &none                  &none
            >;

            label = "SYM";
        };

        nav {
            bindings = <
&none         &none     &none     &none      &none          &none     &none  &none     &none      &none      &none      &none   &none
&caps_word    &kp HOME  &kp UP    &kp END    &kp PAGE_UP    &trans    &none  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans  &kp DELETE
&kp ESCAPE    &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN  &trans    &none  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&kp CAPSLOCK  &trans    &trans    &trans     &trans         &trans    &none  &trans    &trans     &trans     &trans     &trans  &trans
&none         &none     &none     &trans     &exit_nav      &trans    &none  &trans    &exit_nav  &trans     &none      &none
            >;

            label = "NAV";
        };

        fn {
            bindings = <
&none   &none   &none    &none    &none     &none     &none  &none   &none           &none           &none            &none               &none
&trans  &kp F1  &kp F2   &kp F3   &kp F4    &trans    &none  &trans  &kp LC(LA(F1))  &kp LA(LC(F3))  &kp LA(LC(F3))   &kp LA(LC(F4))      &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8    &trans    &none  &trans  &kp LA(LC(F8))  &kp LA(LC(F9))  &kp LA(LC(F10))  &kp LC(LA(DELETE))  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12   &trans    &none  &trans  &trans          &trans          &trans           &trans              &trans
&none   &none   &none    &trans   &exit_fn  &trans    &none  &trans  &exit_fn        &trans          &none            &none
            >;

            label = "FN";
        };

        media {
            bindings = <
&trans  &trans          &trans            &trans           &trans  &trans    &trans  &trans                &trans  &trans  &trans  &trans  &trans
&trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT       &trans  &trans    &trans  &kp C_BRIGHTNESS_INC  &trans  &trans  &trans  &trans  &trans
&trans  &kp C_VOL_DN    &kp C_MUTE        &kp C_VOLUME_UP  &trans  &trans    &trans  &kp C_BRIGHTNESS_DEC  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans            &trans           &trans  &trans    &trans  &trans                &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans            &trans           &mo 10  &trans    &trans  &trans                &trans  &trans  &trans  &trans
            >;

            label = "media";
        };

        func {
            bindings = <
&none         &none         &none         &none         &none         &none           &none  &none  &none  &none  &none  &none  &none
&out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &none  &none  &none  &none  &none  &bt BT_CLR
&out OUT_USB  &none         &none         &none         &none         &none           &none  &none  &none  &none  &none  &none  &none
&bootloader   &none         &none         &none         &to 1         &to 0           &none  &to 0  &to 1  &none  &none  &none  &bootloader
&none         &none         &none         &none         &none         &none           &none  &none  &none  &none  &none  &none
            >;

            label = "func";
        };

        mouse {
            bindings = <
&trans  &trans    &trans    &trans    &trans    &trans      &trans  &trans    &trans    &trans    &trans    &trans    &trans
&trans  &trans    &trans    &trans    &trans    &trans      &trans  &trans    &trans    &trans    &trans    &trans    &trans
&trans  &mkp MB4  &mkp MB3  &mkp MB2  &mkp MB1  &mkp MB5    &trans  &mkp MB4  &mkp MB1  &mkp MB2  &mkp MB3  &mkp MB5  &trans
&trans  &trans    &trans    &trans    &trans    &trans      &trans  &trans    &trans    &trans    &trans    &trans    &trans
&trans  &trans    &trans    &trans    &trans    &trans      &trans  &trans    &trans    &trans    &trans    &trans
            >;
        };
    };
};
